node_modules/
dist/
*.log

# local dev database (the deployed app writes to /data instead, which is
# the Fly volume; see fly.toml)
/data/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Large, unoptimised source images kept only as a local design reference.
# Two of the five (hero-anu, campus-events) have an unverified source/license,
# so they're never committed or shipped — the deployed site uses the
# optimised, verified images in public/images/ instead (see
# public/images/ATTRIBUTION.md).
/public/image/
